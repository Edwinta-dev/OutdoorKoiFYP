# Copy to Backend/.env and fill in real values. Both services (koi.api,
# koi.worker, koi.camera) read this one file through koi/settings.py.
# .env is gitignored. Never commit it: the service-role key has full database access.
# Environment variables of the same name take precedence over this file.

# development: `python -m koi.api` also runs the poller in-process.
# production / test: run `python -m koi.worker` separately.
KOI_ENV=development

# Where the services keep their data: supabase (the live project) or memory
# (in-process tables, empty at start and lost on exit; no database needed).
KOI_STORAGE=supabase

# Supabase project URL, from the Supabase dashboard (Project Settings > API).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase secret (service-role) key. Server-side only; never put it in the app or firmware.
SUPABASE_SERVICEROLE_KEY=REPLACE_ME

# Digital twin API sign-in. required: every pond request needs the app's
# Supabase access token, and only the pond linked to that account
# (UserData.auth_uid) is reachable. disabled: trust the request's user_id;
# refused at start-up unless KOI_ENV=development.
KOI_AUTH=required

# How access tokens are checked. HS256: with the project's JWT secret
# (Project Settings > API > JWT Settings). ES256 or RS256: with the public
# keys at SUPABASE_JWKS_URL, normally
# https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
KOI_JWT_ALGORITHM=HS256
SUPABASE_JWT_SECRET=REPLACE_ME
SUPABASE_JWKS_URL=
# Expected iss claim; empty means SUPABASE_URL + /auth/v1.
KOI_JWT_ISSUER=
KOI_JWT_AUDIENCE=authenticated

# Time zone for the camera's daylight capture slots.
KOI_TIMEZONE=Asia/Singapore

# Minutes between environmental polls of every active pond.
KOI_POLL_INTERVAL_MINUTES=15

# Ponds the worker polls at the same time.
KOI_WORKER_THREADS=4

# Comma-separated browser origins allowed to call the APIs; * allows any.
KOI_CORS_ORIGINS=*

# Storage bucket the analysed frames are written to. Must match POND_IMAGE_BUCKET in the app's env/*.json.
POND_IMAGE_BUCKET=imageAnalysisBucket

# Shared secret the ESP32-CAM sends as X-Device-Token. Must equal DEVICE_TOKEN in
# Embedded/camera_node/secrets.h. When empty, uploads are not authenticated.
DEVICE_TOKEN=REPLACE_ME

# 1 = short fixed camera sleep times for bench testing; 0 = the daylight schedule.
TEST_MODE=1

# Camera state machine: raised frames in a row to enter the dynamic schedule,
# stable frames in a row to leave it, and the green-ratio rise per frame past
# which the dynamic interval steps from 2 h to 1 h to 30 min.
CAMERA_DYNAMIC_ENTER_FRAMES=2
CAMERA_DYNAMIC_EXIT_FRAMES=3
CAMERA_DYNAMIC_RATE_LEVELS=0.10,0.20
