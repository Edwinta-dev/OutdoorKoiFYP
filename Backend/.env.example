# Copy to Backend/.env and fill in real values. Both services (koi.api,
# koi.worker, koi.camera) read this one file through koi/settings.py.
# .env is gitignored. Never commit it: the service-role key has full database access.
# Environment variables of the same name take precedence over this file.

# development: `python -m koi.api` also runs the poller in-process.
# production / test: run `python -m koi.worker` separately.
KOI_ENV=development

# Where the services keep their data: supabase (the live project) or memory
# (in-process tables, empty at start and lost on exit; no database needed).
KOI_STORAGE=supabase

# Supabase project URL, from the Supabase dashboard (Project Settings > API).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase secret (service-role) key. Server-side only; never put it in the app or firmware.
SUPABASE_SERVICEROLE_KEY=REPLACE_ME

# Digital twin API sign-in. required: every pond request needs the app's
# Supabase access token, and only the pond linked to that account
# (UserData.auth_uid) is reachable. disabled: trust the request's user_id;
# refused at start-up unless KOI_ENV=development.
KOI_AUTH=required

# How access tokens are checked. HS256: with the project's JWT secret
# (Project Settings > API > JWT Settings). ES256 or RS256: with the public
# keys at SUPABASE_JWKS_URL, normally
# https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
KOI_JWT_ALGORITHM=HS256
SUPABASE_JWT_SECRET=REPLACE_ME
SUPABASE_JWKS_URL=
# Expected iss claim; empty means SUPABASE_URL + /auth/v1.
KOI_JWT_ISSUER=
KOI_JWT_AUDIENCE=authenticated

# Time zone for the camera's daylight capture slots.
KOI_TIMEZONE=Asia/Singapore

# Minutes between environmental polls of every active pond.
KOI_POLL_INTERVAL_MINUTES=15

# Ponds the worker polls at the same time.
KOI_WORKER_THREADS=4

# Sensor ingestion: expected minutes between the node's uploads (a reading
# is fresh for two of them), how far back each scan overlaps the newest
# ingested insert time, and the most rows one pond ingests per cycle.
KOI_SENSOR_CADENCE_MINUTES=15
KOI_SENSOR_INGEST_OVERLAP_MINUTES=60
KOI_SENSOR_INGEST_BATCH_ROWS=2000

# Evaluation retention: the worker's daily job summarises the evaluation
# rows of local days older than this many days into evaluation_daily and
# deletes them.
KOI_EVALUATION_RETENTION_DAYS=30

# Night-time hypoxia flag: water temperature (C) at or above which a dark
# pond is flagged watch, and high. The watch level must be below high.
KOI_HYPOXIA_WATCH_TEMP_C=30
KOI_HYPOXIA_HIGH_TEMP_C=32

# Comma-separated browser origins allowed to call the APIs; * allows any.
KOI_CORS_ORIGINS=*

# Storage bucket the analysed frames are written to. Must match POND_IMAGE_BUCKET in the app's env/*.json.
POND_IMAGE_BUCKET=imageAnalysisBucket

# Shared secret the ESP32-CAM sends as X-Device-Token. Must equal DEVICE_TOKEN in
# Embedded/camera_node/secrets.h. When empty, uploads are not authenticated.
DEVICE_TOKEN=REPLACE_ME

# 1 = short fixed camera sleep times for bench testing; 0 = the daylight schedule.
TEST_MODE=1

# Camera state machine: raised frames in a row to enter the dynamic schedule,
# stable frames in a row to leave it, and the green-ratio rise per frame past
# which the dynamic interval steps from 2 h to 1 h to 30 min.
CAMERA_DYNAMIC_ENTER_FRAMES=2
CAMERA_DYNAMIC_EXIT_FRAMES=3
CAMERA_DYNAMIC_RATE_LEVELS=0.10,0.20
# Obstruction off-ramp: this many obstructed frames in a row within the
# tolerance (green ratio) of their mean restart the baseline at that mean.
# 0 keeps obstruction latched until the view returns near the old baseline.
CAMERA_OBSTRUCTION_CONFIRM_FRAMES=3
CAMERA_OBSTRUCTION_TOLERANCE=0.05

# NEA weather ingestion (python -m koi.weather). Optional data.gov.sg API key,
# sent as x-api-key; leave empty to use the public rate limit.
NEA_API_BASE_URL=https://api-open.data.gov.sg/v2/real-time/api
NEA_API_KEY=
# Seconds between requests, and attempts per page before a product fails.
NEA_MIN_REQUEST_INTERVAL_SECONDS=1.0
NEA_MAX_ATTEMPTS=5
# Comma-separated station ids and 2-hour forecast areas whose history is kept,
# in addition to those assigned to ponds; * keeps every one.
WEATHER_HISTORY_STATIONS=
WEATHER_HISTORY_AREAS=

# Error tracking with Sentry (API, worker and camera service). Leave the DSN
# empty to turn it off. The DSN comes from the Sentry project's Client Keys page.
# SENTRY_ENVIRONMENT defaults to KOI_ENV; SENTRY_RELEASE defaults to
# koi@<package version>+twin.<snapshot version>. Location, email addresses,
# tokens and request bodies are removed before an event is sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Local development stack, local database profile only (python -m koi.dev
# --profile supabase, docs/dev.md). Leave empty to take them from
# `supabase status -o env`. Only a stack on this machine is accepted.
KOI_DEV_SUPABASE_URL=
KOI_DEV_SUPABASE_SERVICE_ROLE_KEY=
KOI_DEV_DB_URL=
# TDS event questions (off by default). Keep the API and worker settings identical.
KOI_TDS_PROMPTS=false
KOI_TDS_PROMPT_MIN_STEP_PPM=20
KOI_TDS_PROMPT_CONFIDENCE_THRESHOLD=0.8
KOI_TDS_PROMPT_COOLDOWN_HOURS=24
