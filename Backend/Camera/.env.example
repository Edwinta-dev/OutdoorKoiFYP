# Copy to .env on PythonAnywhere (same folder as camera.py) and fill in.
# Never commit the real .env - the service role key has full database access.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICEROLE_KEY=your-secret-or-service-role-key
POND_IMAGE_BUCKET=imageAnalysisBucket
DEVICE_TOKEN=long-random-string-also-flashed-into-the-esp32
TEST_MODE=1
