// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored; never commit it.
#pragma once

// Wi-Fi network the camera joins on each wake.
const char* WIFI_SSID    = "REPLACE_ME";
const char* WIFI_PASS    = "REPLACE_ME";

// Camera service upload endpoint (Backend/koi/camera, POST /upload).
const char* UPLOAD_URL   = "https://YOUR_HOST/upload";

// Must equal DEVICE_TOKEN in Backend/.env. Use a long random string,
// for example: python -c "import secrets; print(secrets.token_urlsafe(24))"
const char* DEVICE_TOKEN = "REPLACE_ME";

// App user id this camera uploads under (the id shown during app onboarding).
const int   USER_ID      = 0;

// Shortest sleep (seconds) the camera accepts from the server. Below 900
// (15 min) is raised to 900 unless CAMERA_TEST_BUILD is defined; a test build
// accepts down to 30 s, short enough for the server's TEST_MODE intervals.
#define CAMERA_MIN_SLEEP_SEC 900
// #define CAMERA_TEST_BUILD
