// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored; never commit it.
#pragma once

// Wi-Fi network the sensor node joins on each wake.
const char *WIFI_SSID = "REPLACE_ME";
const char *WIFI_PASS = "REPLACE_ME";

// Supabase project URL and publishable (anon) key. Never put the secret or
// service-role key on a device: anyone holding the board can read it out.
const char *SUPABASE_URL             = "https://YOUR_PROJECT_REF.supabase.co";
const char *SUPABASE_PUBLISHABLE_KEY = "REPLACE_ME";

// This node's ingest token (issue #12). The owner creates it in the Supabase
// SQL editor with: select public.issue_device_token(<pond id>);
// It is shown once and stored only as a hash; the pond comes from it. Issuing
// a new one keeps this one working for 24 hours, then it stops.
const char *SENSOR_DEVICE_TOKEN = "REPLACE_ME";

// ---- Hardware config: battery divider (issue #42) ----
// Battery + -> R_TOP -> ADC pin -> R_BOTTOM -> switch -> ground, or a
// high-side switch above R_TOP. KOI_BATTERY_EN_PIN drives the switch, HIGH
// = on; it is on only for the reading. The ADC pin must be on ADC1 (GPIO
// 32-39): GPIO 34, 35 (TDS, pH) and 32 (GY-33 power, service build) are
// taken, so GPIO 33. GPIO 13 is not used by any probe or bus. Keep the
// midpoint under about 2.5 V at a full battery: 100k over 47k gives
// 6.4 V -> 2.05 V. For a 12 V pack use a larger ratio (for example 330k
// over 68k) and raise KOI_BATTERY_LOW_MV to suit it.
// Delete the four lines below (or comment out KOI_BATTERY_ADC_PIN) on a node
// without the divider: it then sends no battery_mv.
#define KOI_BATTERY_EN_PIN       13
#define KOI_BATTERY_ADC_PIN      33
#define KOI_BATTERY_R_TOP_OHM    100000.0f
#define KOI_BATTERY_R_BOTTOM_OHM 47000.0f
// Rows are flagged battery_low (16) below this, and the backend warns in
// the notification outbox. 4400 mV suits a linear regulator on 4 alkaline
// cells (report Section 3.2.8).
#define KOI_BATTERY_LOW_MV       4400
