// Copy this file to secrets.h (same folder) and fill in real values.
// secrets.h is gitignored; never commit it.
#pragma once

// Wi-Fi network the sensor node joins on each wake.
const char *WIFI_SSID = "REPLACE_ME";
const char *WIFI_PASS = "REPLACE_ME";

// Supabase project URL and publishable (anon) key. Never put the secret or
// service-role key on a device: anyone holding the board can read it out.
const char *SUPABASE_URL             = "https://YOUR_PROJECT_REF.supabase.co";
const char *SUPABASE_PUBLISHABLE_KEY = "REPLACE_ME";

// This node's ingest token (issue #12). The owner creates it in the Supabase
// SQL editor with: select public.issue_device_token(<pond id>);
// It is shown once and stored only as a hash; the pond comes from it. Issuing
// a new one keeps this one working for 24 hours, then it stops.
const char *SENSOR_DEVICE_TOKEN = "REPLACE_ME";
